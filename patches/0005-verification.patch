diff --git a/test/nexus-server.test.js b/test/nexus-server.test.js
new file mode 100644
index 000000000..4f8621efe
--- /dev/null
+++ b/test/nexus-server.test.js
@@ -0,0 +1,102 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const http = require('node:http');
+const {spawn} = require('node:child_process');
+const {once} = require('node:events');
+const {setTimeout:delay} = require('node:timers/promises');
+const {networkStore} = require('../sidecar/nexus-network');
+function temp(t) {
+  const dir=fs.mkdtempSync(path.join(os.tmpdir(),'nexus-test-'));
+  t.after(()=>fs.rmSync(dir,{recursive:true,force:true})); return dir;
+}
+async function listen(server) { server.listen(0,'127.0.0.1'); await once(server,'listening'); return server.address().port; }
+test('100 endpoints, revisions, migration, private persistence and restart',t=>{
+  const dir=temp(t), open=()=>networkStore(dir,()=>{}), store=open();
+  for(let i=0;i<100;i++) store.save('add',{name:'server '+i,baseUrl:'http://127.0.0.1:9000/v1',key:'fixture-secret'});
+  const rows=store.list(); assert.equal(new Set(rows.map(r=>r.id)).size,100);
+  assert.ok(!JSON.stringify(rows).includes('fixture-secret'));
+  store.save('duplicate',{...rows[0],name:'copy'});
+  store.save('edit',{...rows[0],enabled:false});
+  assert.throws(()=>store.save('delete',rows[0]),/changed/);
+  store.migrate('old','http://localhost:11434/v1');open().migrate('old','http://localhost:11434/v1');
+  assert.equal(open().list().length,102);
+  assert.equal(fs.statSync(path.join(dir,'.secrets/inference-network.json')).mode & 511,384);
+});
+test('authenticated station routes overlapping crew runs to independent servers, survives disconnect and restart',async t=>{
+  const dir=temp(t), markers=['aster','birch'];let active=0,peak=0;
+  const targets=await Promise.all(markers.map(async marker=>{
+    const server=http.createServer(async(req,res)=>{
+      if(req.url==='/v1/models') { res.setHeader('content-type','application/json');return res.end(JSON.stringify({data:[{id:'same-model',context_length:32000}]})); }
+      if(req.url!=='/v1/chat/completions') {res.writeHead(404);return res.end();}
+      req.resume();active++;peak=Math.max(peak,active);await delay(300);active--;
+      res.writeHead(200,{'content-type':'text/event-stream'});
+      for(const item of [{choices:[{delta:{content:marker}}]},{choices:[{delta:{},finish_reason:'stop'}]}]) res.write('data: '+JSON.stringify(item)+'\n\n');
+      res.end('data: [DONE]\n\n');
+    });
+    t.after(()=>server.close());return 'http://127.0.0.1:'+await listen(server)+'/v1';
+  }));
+  const reservation=http.createServer(),port=await listen(reservation);await new Promise(r=>reservation.close(r));
+  const base='http://127.0.0.1:'+port,password=require('node:crypto').randomBytes(24).toString('hex');
+  const headers={authorization:'Basic '+Buffer.from('commander:'+password).toString('base64'),'content-type':'application/json'};
+  let child;
+  async function stop() { if(child && child.exitCode===null && child.signalCode===null) {const done=once(child,'exit');child.kill();await done;} }
+  t.after(stop);
+  async function start() {
+    child=spawn(process.execPath,['scripts/nexus-server.js'],{env:{...process.env,NEXUS_PASSWORD:password,NEXUS_DATA_DIR:dir,NEXUS_PORT:String(port),NEXUS_PUBLIC_URL:base},stdio:'ignore'});
+    for(let i=0;i<200;i++){
+      if(child.exitCode!==null) throw Error('Server exited '+child.exitCode);
+      const r=await fetch(base,{headers}).catch(()=>null);
+      if(r?.ok){headers['x-starnet-token']=(await r.text()).match(/__STARNET_API_TOKEN__="([^"]+)"/)[1];return;}
+      await delay(50);
+    }
+    throw Error('Station startup timed out');
+  }
+  const call=(route,body,extra={})=>fetch(base+route,{method:body?'POST':'GET',headers,body:body?JSON.stringify(body):undefined,...extra});
+  await start();
+  assert.equal((await fetch(base)).status,401);
+  assert.equal((await call('/api/nexus/network',null,{headers:{...headers,origin:'https://foreign.invalid'}})).status,403);
+  const ids=[];
+  for(let i=0;i<2;i++){
+    const r=await call('/api/nexus/network',{action:'add',name:markers[i],baseUrl:targets[i],model:'same-model'});
+    assert.equal(r.status,200);const row=(await r.json()).at(-1);assert.deepEqual(row.models,['same-model']);ids.push(row.id);
+  }
+  const roster=await call('/api/roster',{agents:ids.map((provider,i)=>({agentId:'crew-'+i,name:markers[i],model:'same-model',provider}))});
+  assert.equal(roster.status,200);
+  const run=(id,fields={},extra)=>call('/api/run',{agentId:id,model:'same-model',messages:[{role:'user',content:'say hello'}],...fields},extra);
+  await Promise.all(ids.map(async(_,i)=>{const r=await run('crew-'+i);assert.equal(r.status,200);assert.match(await r.text(),new RegExp(markers[i]));}));
+  assert.ok(peak>=2,'requests overlapped across machines');
+  const ac=new AbortController(), detached=await run('unattended',{provider:ids[0]},{signal:ac.signal});assert.equal(detached.status,200);ac.abort();
+  let complete=false;
+  for(let i=0;i<80&&!complete;i++){await delay(100);const history=await (await call('/api/runs?agent=unattended')).json();complete=history.runs?.some(r=>r.reason==='done');}
+  assert.ok(complete,'disconnected task finished');
+  await stop();await start();assert.deepEqual((await (await call('/api/nexus/network')).json()).map(r=>r.id),ids);
+});
+test('authorized failover preserves streamed tool arguments, credential origin and context ceiling',async t=>{
+  const root=temp(t), registry=require('../sidecar/providers/registry'),factory=require('../sidecar/providers/factory');
+  const store=networkStore(root,registry.setNetwork);factory.attachNetwork(store);
+  let available=false,requests=0;
+  const server=http.createServer(async(req,res)=>{
+    if(req.url==='/v1/models') {res.setHeader('content-type','application/json');return res.end(JSON.stringify({data:[{id:'same',context_length:8192}]}));}
+    requests++;assert.equal(req.headers.authorization,'Bearer secondary-secret');
+    res.writeHead(200,{'content-type':'text/event-stream'});
+    const fn={id:'one',index:0,type:'function',function:{name:'measure',arguments:'{}'}};
+    res.end('data: '+JSON.stringify({choices:[{delta:{tool_calls:[fn]},finish_reason:'tool_calls'}]})+'\n\ndata: [DONE]\n\n');
+  });
+  t.after(()=>server.close());const url='http://127.0.0.1:'+await listen(server);
+  const dead=http.createServer((req,res)=>{res.writeHead(available?200:503,{'content-type':'application/json'});res.end(JSON.stringify({data:[{id:'same'}]}));});
+  t.after(()=>dead.close());const primaryURL='http://127.0.0.1:'+await listen(dead);
+  const common={model:'same',context:4000,tools:true};
+  const secondary=store.save('add',{...common,name:'secondary',baseUrl:url+'/v1',key:'secondary-secret'})[0];
+  const primary=store.save('add',{...common,name:'primary',baseUrl:primaryURL+'/v1',key:'primary-secret',mode:'failover',alternatives:[secondary.id]}).at(-1);
+  const adapter=factory.selectProvider({provider:primary.id});
+  assert.equal(adapter.contextLimit('same'),4000);
+  const events=[];
+  for await(const e of adapter.stream({model:'same',messages:[{role:'user',content:'measure'}],tools:[]}))events.push(e);
+  assert.ok(events.some(e=>e.type==='tool_start'&&e.name==='measure'));assert.ok(events.some(e=>e.type==='tool_args'&&e.chunk==='{}'));
+  assert.equal(requests,1);assert.equal(store.list()[0].windows.same,8192);
+  assert.equal(store.list().at(-1).status,'offline');available=true;assert.equal((await store.probe(primary.id)).status,'online');
+});

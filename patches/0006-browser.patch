diff --git a/test/helpers/nexus-loopback.cjs b/test/helpers/nexus-loopback.cjs
new file mode 100644
index 000000000..e88c50852
--- /dev/null
+++ b/test/helpers/nexus-loopback.cjs
@@ -0,0 +1,8 @@
+// The browser fixture runs a real station but owns only two loopback HTTP servers.
+const net=require('node:net');
+const original=net.Socket.prototype.connect;
+net.Socket.prototype.connect=function(...args) {
+  const options=Array.isArray(args[0]) ? args[0][0] : net._normalizeArgs(args)[0];
+  if (options.path || !['127.0.0.1','::1','localhost'].includes(options.host || 'localhost')) throw Error('Fixture only permits loopback');
+  return original.apply(this,args);
+};
diff --git a/test/nexus-browser.py b/test/nexus-browser.py
new file mode 100644
index 000000000..87604276a
--- /dev/null
+++ b/test/nexus-browser.py
@@ -0,0 +1,90 @@
+"""Run with Python Playwright and NEXUS_CHROMIUM pointing to a Chromium executable."""
+import json
+import os
+import secrets
+import socket
+import subprocess
+import tempfile
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.request import urlopen
+from urllib.error import HTTPError, URLError
+from playwright.sync_api import sync_playwright
+
+class Catalog(BaseHTTPRequestHandler):
+    def do_GET(self):
+        self.send_response(200)
+        self.send_header('Content-Type', 'application/json')
+        self.end_headers()
+        self.wfile.write(json.dumps({'data': [{'id': 'nexus-demo'}]}).encode())
+    def do_POST(self):
+        if self.path!='/v1/chat/completions':
+            self.send_error(404)
+            return
+        self.rfile.read(int(self.headers.get('content-length','0')))
+        self.send_response(200)
+        self.send_header('Content-Type','text/event-stream')
+        self.end_headers()
+        for choice in [{'delta':{'content':'OK'}},{'delta':{},'finish_reason':'stop'}]:
+            self.wfile.write(('data: '+json.dumps({'choices':[choice]})+'\n\n').encode())
+        self.wfile.write(b'data: [DONE]\n\n')
+    def log_message(self, *args):
+        pass
+
+mock = ThreadingHTTPServer(('127.0.0.1', 0), Catalog)
+threading.Thread(target=mock.serve_forever, daemon=True).start()
+with socket.socket() as reservation:
+    reservation.bind(('127.0.0.1', 0))
+    port = reservation.getsockname()[1]
+base = f'http://127.0.0.1:{port}'
+password = secrets.token_urlsafe(32)
+with tempfile.TemporaryDirectory() as data:
+    server = subprocess.Popen(['node', '--require', './test/helpers/nexus-loopback.cjs', 'scripts/nexus-server.js'], env=dict(PATH=os.environ['PATH'], HOME=data, NEXUS_PORT=str(port),
+        NEXUS_PASSWORD=password, NEXUS_DATA_DIR=data, NEXUS_PUBLIC_URL=base), stdout=subprocess.DEVNULL)
+    try:
+        for attempt in range(100):
+            try:
+                urlopen(base)
+            except HTTPError as error:
+                assert error.code == 401
+                break
+            except URLError:
+                time.sleep(.1)
+        with sync_playwright() as pw:
+            browser = pw.chromium.launch(executable_path=os.environ.get('NEXUS_CHROMIUM'),args=['--no-sandbox','--disable-dev-shm-usage','--no-zygote','--use-gl=angle','--use-angle=swiftshader','--enable-unsafe-swiftshader'])
+            def new_page():
+                context = browser.new_context(viewport={'width':900,'height':650},reduced_motion='reduce',http_credentials={'username': 'commander', 'password': password})
+                context.route('**/*', lambda route: route.continue_() if route.request.url.startswith(base + '/') else route.abort())
+                return context.new_page()
+            first, second = new_page(), new_page()
+            first.goto(base,wait_until='domcontentloaded')
+            first.get_by_text('PRESS ANY KEY TO START',exact=False).click()
+            first.locator('#in-name').fill('Nova')
+            first.locator('#btn-setup-next').click()
+            first.locator('#genesis-network summary').click()
+            panel = first.locator('#genesis-network inference-network')
+            panel.get_by_text('Add endpoint',exact=True).click()
+            panel.locator('[name=name]').fill('Local test machine')
+            panel.locator('[name=baseUrl]').fill(f'http://127.0.0.1:{mock.server_port}/v1')
+            panel.locator('[name=model]').fill('nexus-demo')
+            panel.get_by_text('Save endpoint').click()
+            panel.get_by_text('Test connection').click()
+            panel.get_by_text('Use this endpoint').click()
+            first.locator('#btn-wake').click()
+            for _ in range(100):
+                snapshot=first.evaluate("""async()=>{const r=await fetch('/api/save?agent=agent',{headers:{'X-StarNet-Token':window.__STARNET_API_TOKEN__}});let b=await r.json();return [r.status,b.error,b.save?.agent?.model,b.save?.agent?.name]}""")
+                if snapshot[2]=='nexus-demo': break
+                first.wait_for_timeout(200)
+            assert snapshot[2]=='nexus-demo', (snapshot,first.locator('body').inner_text()[-2600:])
+            second.goto(base,wait_until='domcontentloaded')
+            first.context.close()
+            second.wait_for_function("() => typeof Save!=='undefined' && Save.load()?.agent?.name==='NOVA'",timeout=45000)
+            assert second.evaluate("Save.load().agent.model")=='nexus-demo'
+            second.get_by_text('COMMS · General',exact=False).first.wait_for(timeout=45000)
+            browser.close()
+            print('PASS: two isolated browser contexts resumed the same station after endpoint onboarding')
+    finally:
+        server.terminate()
+        server.wait(timeout=15)
+        mock.shutdown()

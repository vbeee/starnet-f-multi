index 000000000..3f8d8e19a
--- /dev/null
+++ b/sidecar/nexus-network.js
@@ -0,0 +1,157 @@
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const { randomUUID } = require('node:crypto');
+const { writeFileDurable } = require('./durable-write');
+const { classifyHost } = require('./net/safe-egress');
+
+function privateTarget(url) {
+  const host = classifyHost(new URL(url).hostname);
+  return host.ip && !host.embedded && ['private','loopback','unique-local','cgnat'].includes(host.kind);
+}
+
+function networkStore(root, publish) {
+  const file = path.join(root,'.secrets','inference-network.json');
+  let saved = { rows: [], imported: false };
+  try { saved = JSON.parse(fs.readFileSync(file,'utf8')); }
+  catch (e) { if (e.code !== 'ENOENT') throw e; }
+  let rows = new Map(saved.rows.map(r => [r.id,r]));
+  const states = new Map();
+  let cursor = 0;
+  function state(id) {
+    if (!states.has(id)) states.set(id,{active:0,waiting:[],status:'unknown',models:[]});
+    return states.get(id);
+  }
+  function list() {
+    return Array.from(rows.values(), ({key,...entry}) => {
+      const {waiting,...health} = state(entry.id);
+      return {...entry, ...health, hasKey:!!key, queued:waiting.length, status:health.active >= entry.concurrency ? 'busy' : health.status};
+    });
+  }
+  function save(action, input, importing = false) {
+    const old = action === 'add' ? undefined : rows.get(input.id);
+    if (action !== 'add' && (!old || old.rev !== input.rev)) throw Error('Endpoint changed. Refresh and retry.');
+    const next = new Map(rows);
+    if (action === 'delete') {
+      next.delete(old.id);
+      for (const r of next.values()) if (r.alternatives.includes(old.id)) next.set(r.id,{...r,rev:randomUUID(),alternatives:r.alternatives.filter(id => id !== old.id)});
+    } else {
+      if (!['add','edit','duplicate'].includes(action)) throw Error('Unknown endpoint operation');
+      const v = {...old,...input};
+      const url = new URL(v.baseUrl);
+      if (!['http:','https:'].includes(url.protocol) || url.username || url.password || url.search || url.hash) throw Error('Use an HTTP(S) base URL without embedded credentials, query or fragment');
+      const baseUrl = url.href.replace(/\/+$/,'');
+      const r = { id: action === 'edit' ? old.id : 'nexus-'+randomUUID(), rev:randomUUID(), baseUrl,
+        name:String(v.name || '').trim(), model:String(v.model || '').trim(), key:String(input.key ?? (old?.baseUrl === baseUrl ? old.key : '') ?? ''),
+        enabled:v.enabled !== false, protocol:v.protocol || 'openai', auth:v.auth || 'bearer', mode:v.mode || 'manual',
+        alternatives:[...new Set(v.alternatives || [])] };
+      if (!r.name || !['openai','ollama'].includes(r.protocol) || !['bearer','x-api-key'].includes(r.auth)) throw Error('Invalid name, protocol or authentication');
+      if (!['manual','priority','balance','failover','local'].includes(r.mode) || (r.mode === 'local' && !privateTarget(baseUrl))) throw Error('Local-only routing requires a private IP address');
+      if (r.alternatives.some(id => !rows.has(id) || id === r.id)) throw Error('Unknown alternative');
+      for (const [field,initial,min] of [['context',0,0],['output',0,0],['timeout',120000,1],['concurrency',1,1],['priority',0,0]]) {
+        r[field] = Number(v[field] ?? initial);
+        if (!Number.isSafeInteger(r[field]) || r[field] < min || r[field] > 2147483647) throw Error('Invalid '+field);
+      }
+      for (const field of ['tools','vision']) r[field] = typeof v[field] === 'boolean' ? v[field] : null;
+      next.set(r.id,r);
+    }
+    const record = { rows:[...next.values()], imported:saved.imported || importing };
+    fs.mkdirSync(path.dirname(file),{recursive:true,mode:0o700});
+    writeFileDurable({fs,path},file,JSON.stringify(record));
+    rows = next; saved = record;
+    if (old && action !== 'duplicate') Object.assign(state(old.id),{status:'unknown',latency:null,models:[],error:'',speed:null});
+    publish(list());
+    return list();
+  }
+  function transport(row, send) {
+    return (url, init = {}) => {
+      if (row !== rows.get(row.id) || !row.enabled) throw Error('Endpoint disabled or changed');
+      if (new URL(url).origin !== new URL(row.baseUrl).origin) throw Error('Endpoint origin mismatch');
+      const headers = new Headers(init.headers);
+      headers.delete('authorization'); headers.delete('x-api-key');
+      if (row.key) {
+        if (row.auth === 'x-api-key') headers.set('x-api-key',row.key);
+        else headers.set('authorization','Bearer '+row.key);
+      }
+      const timeout = AbortSignal.timeout(row.timeout);
+      if (init.signal && typeof AbortSignal.any !== 'function') throw Error('Nexus requires Node 22');
+      const signal = init.signal && typeof AbortSignal.any === 'function' ? AbortSignal.any([timeout,init.signal]) : timeout;
+      return send(url,{...init,headers,signal,redirect:'error'});
+    };
+  }
+  async function probe(id) {
+    const row = rows.get(id);
+    if (!row?.enabled) throw Error('Endpoint unavailable');
+    const s = state(id), start = performance.now();
+    try {
+      const res = await transport(row,fetch)(row.baseUrl+'/models');
+      if (!res.ok) throw Error('HTTP '+res.status);
+      const body = await res.json();
+      if (!Array.isArray(body.data)) throw Error('Invalid catalog');
+      if (row === rows.get(id)) Object.assign(s,{status:'online',error:'',models:body.data.map(m=>m.id).filter(m=>typeof m === 'string')});
+    } catch (e) {
+      if (row === rows.get(id)) Object.assign(s,{status:'offline',error:/^HTTP \d+$/.test(e.message) ? e.message : 'Discovery failed',models:[]});
+    }
+    if (row === rows.get(id)) s.latency = Math.round(performance.now()-start);
+    return s;
+  }
+  function direct(row,opts,build) {
+    const base = build({...opts,provider:row.id,key:row.key,headers:{},baseUrl:row.baseUrl,fetch:transport(row,opts.fetch || fetch)});
+    const s = state(row.id);
+    return {...base, contextLimit:row.context ? () => row.context : base.contextLimit,
+      supportsImages:row.vision === null ? base.supportsImages : () => row.vision,
+      async *stream(req) {
+        while (s.active >= row.concurrency) {
+          req.signal?.throwIfAborted();
+          await new Promise((resolve,reject) => {
+            function wake() { req.signal?.removeEventListener('abort',cancel); resolve(); }
+            function cancel() { s.waiting.splice(s.waiting.indexOf(wake),1); reject(req.signal.reason); }
+            s.waiting.push(wake); req.signal?.addEventListener('abort',cancel,{once:true});
+          });
+        }
+        const start = performance.now();
+        s.active++;
+        try {
+          for await (const event of base.stream(req)) {
+            const tokens = event.usage?.completion_tokens;
+            if (event.type === 'usage' && Number.isFinite(tokens)) s.speed = tokens*1000/Math.max(1,performance.now()-start);
+            yield event;
+          }
+        } finally { s.active--; s.waiting.shift()?.(); }
+      }};
+  }
+  function adapter(opts,build) {
+    const primary = rows.get(opts.provider);
+    if (!primary?.enabled) throw Error('Inference endpoint unavailable');
+    const base = direct(primary,opts,build);
+    if (primary.mode === 'manual') return base;
+    let choice;
+    async function select(req) {
+      const choices = [primary,...primary.alternatives.map(id=>rows.get(id))].filter(r=>r?.enabled &&
+        (primary.mode !== 'local' || privateTarget(r.baseUrl)) && (r === primary || ((!req.tools?.length || r.tools === true) &&
+        (primary.vision !== true || r.vision === true) && r.context >= primary.context && r.output >= primary.output)));
+      if (primary.mode === 'priority') choices.sort((a,b)=>b.priority-a.priority);
+      if (primary.mode === 'balance' && choices.length) {
+        choices.push(...choices.splice(0,cursor++ % choices.length));
+        const load = r => (state(r.id).active+state(r.id).waiting.length)/r.concurrency;
+        choices.sort((a,b)=>load(a)-load(b));
+      }
+      for (const r of choices) {
+        req.signal?.throwIfAborted();
+        const health = await probe(r.id);
+        if (health.status === 'online' && (health.models.includes(req.model) || r.model === req.model)) return r === primary ? base : direct(r,opts,build);
+      }
+      throw Error('No compatible authorized endpoint available');
+    }
+    return {...base, async *stream(req) {
+      choice ||= select(req);
+      const target = await choice;
+      if (primary !== rows.get(primary.id)) throw Error('Routing configuration changed');
+      yield* target.stream(req);
+    }};
+  }
+  publish(list());
+  return {list,save,adapter,probe,get:id=>rows.get(id),keys:()=>[...rows.values()].map(r=>r.key).filter(Boolean),
+    migrate(key,baseUrl) { if (!saved.imported && baseUrl) save('add',{name:'Custom endpoint (imported)',key,baseUrl},true); }};
+}
+module.exports = {networkStore};

diff --git a/sidecar/nexus-access.js b/sidecar/nexus-access.js
new file mode 100644
index 000000000..55012f197
--- /dev/null
+++ b/sidecar/nexus-access.js
@@ -0,0 +1,37 @@
+'use strict';
+const fs = require('node:fs');
+const crypto = require('node:crypto');
+const digest = value => crypto.createHash('sha256').update(value).digest();
+
+function configure(env, port) {
+  const bind = env.NEXUS_LISTEN || '127.0.0.1';
+  const tls = env.NEXUS_TLS_KEY && env.NEXUS_TLS_CERT
+    ? {key:fs.readFileSync(env.NEXUS_TLS_KEY), cert:fs.readFileSync(env.NEXUS_TLS_CERT)} : null;
+  if (!tls && !['localhost','127.0.0.1','::1'].includes(bind)) throw Error('Network listeners require a TLS key and certificate');
+  const password = env.NEXUS_PASSWORD_FILE ? fs.readFileSync(env.NEXUS_PASSWORD_FILE,'utf8').trimEnd() : env.NEXUS_PASSWORD;
+  if (!password || password.length < 24) throw Error('Configure a Nexus password of at least 24 characters');
+  const expected = digest('Basic '+Buffer.from('commander:'+password).toString('base64'));
+  delete env.NEXUS_PASSWORD;
+  const origins = new Set([env.NEXUS_PUBLIC_URL || ('http://localhost:'+port), ...String(env.NEXUS_ALLOWED_ORIGINS || '').split(',').filter(Boolean)].map(value => {
+    const u = new URL(value.trim());
+    if (u.username || u.password || u.search || u.hash || u.pathname !== '/' || (u.protocol !== 'https:' && !(u.protocol === 'http:' && ['127.0.0.1','localhost','[::1]'].includes(u.hostname)))) throw Error('Invalid Nexus origin. Remote origins require HTTPS.');
+    return u.origin;
+  }));
+  const hosts = new Set([...origins].map(o=>new URL(o).host));
+  function authorize(req,res) {
+    function reject(code) {
+      res.writeHead(code,{'Cache-Control':'no-store',...(code===401?{'WWW-Authenticate':'Basic realm="StarNet Nexus", charset="UTF-8"'}:{})});
+      res.end(code===401?'Authentication required':'Forbidden');
+      return false;
+    }
+    if (!hosts.has(req.headers.host) || req.headers.origin && !origins.has(req.headers.origin) || req.headers['sec-fetch-site']==='cross-site') return reject(403);
+    if (!crypto.timingSafeEqual(expected,digest(req.headers.authorization || ''))) return reject(401);
+    if (!['GET','HEAD','OPTIONS'].includes(req.method) && !req.headers.origin && !req.headers['x-starnet-token']) return reject(403);
+    delete req.headers.authorization;
+    req.headers.host='127.0.0.1:'+port;
+    if (req.headers.origin) req.headers.origin='http://'+req.headers.host;
+    return true;
+  }
+  return {bind,tls,authorize};
+}
+module.exports = {configure};

diff --git a/website/app/app/nexus-network.js b/website/app/app/nexus-network.js
new file mode 100644
index 000000000..fbce3717b
--- /dev/null
+++ b/website/app/app/nexus-network.js
@@ -0,0 +1,81 @@
+'use strict';
+class InferenceNetwork extends HTMLElement {
+  connectedCallback() { this.refresh(); }
+  node(tag,text,parent=this) {
+    const el=document.createElement(tag);
+    el.textContent=text;
+    parent.append(el);
+    return el;
+  }
+  button(parent,label,action) {
+    const button=this.node('button',label,parent);
+    button.type='button'; button.className='bb sm'; button.onclick=action;
+  }
+  async refresh(payload) {
+    try {
+      const res=await fetch('/api/nexus/network',payload ? {method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)} : {cache:'no-store'});
+      const rows=await res.json();
+      if (!res.ok) throw Error(rows.error || 'Network unavailable');
+      this.rows=rows;
+      SK.providers.registry.setNetwork(rows);
+      this.replaceChildren();
+      this.node('h4','Inference Network').className='ms-h';
+      this.button(this,'Add endpoint',()=>this.edit({}));
+      this.button(this,'Refresh',()=>this.refresh());
+      for (const r of rows) {
+        const box=this.node('section','');
+        this.node('strong',r.name,box);
+        const info=[r.enabled ? r.status : 'disabled',r.baseUrl,r.active+' active',r.queued+' queued',r.error];
+        if (Number.isFinite(r.latency)) info.push(r.latency+' ms');
+        if (Number.isFinite(r.speed)) info.push(r.speed.toFixed(1)+' output tokens/s (whole request)');
+        this.node('p',info.filter(Boolean).join(' · '),box);
+        this.node('p',r.models.join(', ') || r.model || 'No catalog yet',box);
+        const action=(name,extra={})=>this.refresh({action:name,id:r.id,rev:r.rev,...extra});
+        const setup=this.closest('#genesis-network');
+        if (setup && r.enabled) this.button(box,'Use this endpoint',()=>setup.chooseEndpoint(r));
+        this.button(box,'Test connection',()=>action('test'));
+        this.button(box,'Edit',()=>this.edit(r));
+        this.button(box,'Duplicate',()=>action('duplicate',{name:r.name+' copy'}));
+        this.button(box,r.enabled?'Disable':'Enable',()=>action('edit',{enabled:!r.enabled}));
+        this.button(box,'Delete',()=>{if(confirm('Delete '+r.name+'?')) action('delete');});
+      }
+    } catch(e) {this.node('p',e.message);}
+  }
+  edit(row) {
+    this.replaceChildren();
+    const form=this.node('form','');
+    const fields=[['name','Display name'],['baseUrl','API base URL including /v1'],['key','API key (blank keeps current key on same URL)'],
+      ['auth','Authentication',['bearer','x-api-key']],['protocol','Protocol',['openai','ollama']],['model','Manual model ID'],
+      ['context','Context window',0],['output','Maximum output tokens',0],['timeout','Timeout in milliseconds',120000],
+      ['concurrency','Maximum concurrent requests',1],['priority','Priority',0],['tools','Tool calling',['unknown','yes','no']],
+      ['vision','Vision',['unknown','yes','no']],['mode','Routing',['manual','priority','balance','failover','local']]];
+    for (const [name,label,options] of fields) {
+      const line=this.node('label',label+' ',this.node('p','',form));
+      const input=this.node(Array.isArray(options)?'select':'input','',line);
+      input.name=name;
+      if (Array.isArray(options)) {
+        for(const value of options) this.node('option',value,input);
+        input.value=typeof row[name]==='boolean'?(row[name]?'yes':'no'):row[name] || options[0];
+      } else {
+        input.type=name==='key'?'password':typeof options==='number'?'number':'text';
+        input.value=row[name] ?? options ?? '';
+      }
+    }
+    this.node('p','Authorized alternatives',form);
+    for(const r of this.rows.filter(r=>r.id!==row.id)) {
+      const input=this.node('input','',this.node('label',r.name+' ',form));
+      input.type='checkbox';input.name='alternate';input.value=r.id;
+      input.checked=row.alternatives?.includes(r.id) || false;
+    }
+    this.node('button','Save endpoint',form).className='bb sm';
+    this.button(form,'Cancel',()=>this.refresh());
+    form.onsubmit=event=>{
+      event.preventDefault();
+      const data=new FormData(form), values=Object.fromEntries(data);
+      if(!values.key) delete values.key;
+      for(const field of ['tools','vision']) values[field]=values[field]==='unknown'?null:values[field]==='yes';
+      this.refresh({...values,alternatives:data.getAll('alternate'),action:row.id?'edit':'add',id:row.id,rev:row.rev});
+    };
+  }
+}
+customElements.define('inference-network',InferenceNetwork);
